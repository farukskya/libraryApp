@model IEnumerable<libraryApp.Models.Book>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary m-0">📚 Kütüphane Kitap Listesi</h2>

        @* Yeni Kitap Ekle butonu her zaman görünür *@
        @* Giriş yapmayan veya Admin olmayan biri basarsa doğrudan Giriş Ekranına uçar *@
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Add" class="btn btn-primary px-4 fw-bold shadow-sm">+ Yeni Kitap Ekle</a>
        }
        else
        {
            @* Eğer Admin değilse veya Giriş yapmadıysa tıklandığı an Login sayfasına yönlendirilir *@
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 fw-bold shadow-sm">+ Yeni Kitap Ekle</a>
        }
    </div>

    <div class="card border-0 shadow-sm bg-light p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Kitap adı veya yazar ara..." />
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name", ViewData["CurrentCategory"]))">
                    <option value="">-- Tüm Kategoriler --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100 fw-semibold">Filtrele</button>
                <a asp-action="Index" class="btn btn-secondary w-100 fw-semibold">Temizle</a>
            </div>
        </form>
    </div>

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover table-striped align-middle bg-white m-0">
            <thead class="table-dark">
                <tr>
                    <th><a class="text-white text-decoration-none" asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">Kitap Adı ⇅</a></th>
                    <th>Yazar</th>
                    <th><a class="text-white text-decoration-none" asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">Fiyat ⇅</a></th>
                    <th><a class="text-white text-decoration-none" asp-action="Index" asp-route-sortOrder="@ViewData["StockSortParam"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">Stok ⇅</a></th>
                    <th>Kategori</th>
                    <th class="text-center" style="width: 250px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@item.Title</td>
                        <td>@item.Author</td>
                        <td class="text-success fw-bold">@item.Price.ToString("C2")</td>
                        <td>
                            <span class="badge @(item.Stock > 5 ? "bg-info text-dark" : "bg-danger") px-2.5 py-1.5">
                                @item.Stock Adet
                            </span>
                        </td>
                        <td><span class="badge bg-secondary px-2 py-1">@item.Category?.Name</span></td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">

                                @* DETAY: Herkes basabilir, giriş yapmayan basarsa Login'e gider *@
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white px-2.5">Detay</a>

                                @* TAM YETKİLİ ADMIN SENARYOSU *@
                                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark px-2.5">Güncelle</a>

                                    @* Admin basarsa onay alır ve arka plandaki POST formunu ateşler *@
                                    <a href="javascript:void(0);"
                                       onclick="if(confirm('Bu kitabı silmek istediğinize emin misiniz?')) { document.getElementById('delete-form-@item.Id').submit(); }"
                                       class="btn btn-sm btn-danger px-2.5">Sil</a>

                                    <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:none;">
                                        @Html.AntiForgeryToken()
                                    </form>
                                }
                                else
                                {
                                    @* KAPTANIN İSTEDİĞİ DEĞİŞİKLİK BURASI: *@
                                    @* Hem giriş yapmamış anonim kullanıcı hem de normal USER rolündeki kullanıcı *@
                                    @* Güncelle veya Sil butonuna bastığı an doğrudan Account/Login (Giriş) sayfasına fırlatılır! *@
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-warning text-dark px-2.5">Güncelle</a>
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-danger px-2.5">Sil</a>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>