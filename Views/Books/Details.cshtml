@model libraryApp.Models.Book

@{
    ViewData["Title"] = "Kitap Detayları";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">@Model.Title - Kitap Künyesi</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <table class="table table-bordered">
                        <tr>
                            <th class="bg-light" style="width: 30%">Kitap Adı:</th>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Yazar:</th>
                            <td>@Model.Author</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Kategori:</th>
                            <td><span class="badge bg-info text-dark">@Model.Category?.Name</span></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Fiyat:</th>
                            <td>@Model.Price.ToString("C2")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Stok Adedi:</th>
                            <td>@Model.Stock Adet</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
        </div>
    </div>
</div>