                <p class="mb-0">Lütfen sistem yöneticisi (Admin) hesabı ile giriş yapınız.</p>
                <a asp-controller="Books" asp-action="Index" class="btn btn-danger mt-4 px-4 py-2">Kitap Listesine Dön</a>
            </div>
        </div>
    </div>
</div>