@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger py-5 shadow">
                <h1 class="display-1 fw-bold text-danger">🛑</h1>
                <h2 class="fw-bold mt-3">Erişim Engellendi!</h2>
